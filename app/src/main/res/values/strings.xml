    <string name="share_step1_title">1. Connect the device to the same network</string>
    <string name="share_step1_text">Use the same Wi-Fi as this phone, or turn on the hotspot on this phone and connect to it. Devices on the hotspot don\'t get VPN by themselves: set up the proxy on them.</string>
    <string name="share_hotspot_settings">Hotspot settings</string>
    <string name="share_step2_title">2. Set up the proxy on the device</string>
    <string name="share_step2_text">Enter the address and port shown above. Choose your device:</string>
    <string name="share_step3_title">3. Check</string>
    <string name="share_step3_text">Open 2ip.ru on the device: it should show the VPN server\'s address, not yours.</string>
    <string name="share_warning">Only devices on your local network can use the proxy, and no password is needed. Turn sharing off when you don\'t need it.</string>
    <string name="guide_windows">Windows</string>
    <string name="guide_windows_text">Settings → Network &amp; Internet → Proxy → Manual proxy setup → Set up. Turn on «Use a proxy server», enter address %1$s and port %2$s, then Save.</string>
    <string name="guide_macos">macOS</string>
    <string name="guide_macos_text">System Settings → Network → Wi-Fi → Details → Proxies. Turn on «Web proxy (HTTP)» and «Secure web proxy (HTTPS)», enter %1$s and port %2$s in both, then OK.</string>
    <string name="guide_ios">iPhone and iPad</string>
    <string name="guide_ios_text">Settings → Wi-Fi → tap ⓘ next to the network → Configure Proxy → Manual. Server %1$s, port %2$s, then Save.</string>
    <string name="guide_android">Android</string>
    <string name="guide_android_text">Settings → Wi-Fi → tap the network (or ⚙) → Edit → Advanced options → Proxy → Manual. Hostname %1$s, port %2$s, then Save.</string>
    <string name="guide_tv">Smart TV and set-top boxes</string>
    <string name="guide_tv_text">In the network settings of the TV find «Proxy» (sometimes in advanced Wi-Fi settings), choose manual and enter %1$s and port %2$s. Not every TV supports a proxy.</string>
    <string name="guide_apps">Telegram and other apps</string>
    <string name="guide_apps_text">Telegram: Settings → Data and Storage → Proxy → Add Proxy → SOCKS5. Server %1$s, port %3$s. Browsers and other apps with SOCKS5 support are set up the same way.</string>
    <string name="share_phone_ip">phone IP</string>

